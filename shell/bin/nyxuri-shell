#!/usr/bin/env bash
# ==============================================================================
# Nyxuri Shell Launcher & Gateway (nyxuri-shell)
# Native wrapper for starting Nyxuri Shell and dispatching shell actions.
# ==============================================================================

set -euo pipefail

SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
SHELL_DIR=$(CDPATH='' cd -- "${SCRIPT_DIR}/.." && pwd)
REPO_ROOT=$(CDPATH='' cd -- "${SHELL_DIR}/.." && pwd)

# Explicit build paths are authoritative; an invalid override must not
# silently load an unrelated build. Existing QML search paths keep priority.
NATIVE_PLUGIN_PATH=""
if [ -n "${CLAVIS_QML_BUILD_DIR:-}" ]; then
    NATIVE_PLUGIN_PATH="${CLAVIS_QML_BUILD_DIR}"
elif [ -n "${CLAVIS_BUILD_DIR:-}" ]; then
    NATIVE_PLUGIN_PATH="${CLAVIS_BUILD_DIR}/qml"
elif [ -d "${REPO_ROOT}/build/shell-test/qml" ]; then
    NATIVE_PLUGIN_PATH="${REPO_ROOT}/build/shell-test/qml"
elif [ -d "${SHELL_DIR}/build/qml" ]; then
    NATIVE_PLUGIN_PATH="${SHELL_DIR}/build/qml"
elif [ -d "${SHELL_DIR}/native/build/qml" ]; then
    NATIVE_PLUGIN_PATH="${SHELL_DIR}/native/build/qml"
fi

if [ -n "${NATIVE_PLUGIN_PATH}" ]; then
    if [ ! -d "${NATIVE_PLUGIN_PATH}" ]; then
        printf 'Native QML build directory does not exist: %s\n' "${NATIVE_PLUGIN_PATH}" >&2
        exit 1
    fi
    if [ -n "${CLAVIS_QML_BUILD_DIR:-}${CLAVIS_BUILD_DIR:-}" ]; then
        export QML_IMPORT_PATH="${NATIVE_PLUGIN_PATH}${QML_IMPORT_PATH:+:${QML_IMPORT_PATH}}"
        export QML2_IMPORT_PATH="${NATIVE_PLUGIN_PATH}${QML2_IMPORT_PATH:+:${QML2_IMPORT_PATH}}"
    else
        export QML_IMPORT_PATH="${QML_IMPORT_PATH:+${QML_IMPORT_PATH}:}${NATIVE_PLUGIN_PATH}"
        export QML2_IMPORT_PATH="${QML2_IMPORT_PATH:+${QML2_IMPORT_PATH}:}${NATIVE_PLUGIN_PATH}"
    fi
fi

FALLBACK_QML_PATH="${SHELL_DIR}/native/fallback"
if [ -d "${FALLBACK_QML_PATH}" ]; then
    export QML_IMPORT_PATH="${QML_IMPORT_PATH:+${QML_IMPORT_PATH}:}${FALLBACK_QML_PATH}"
    export QML2_IMPORT_PATH="${QML2_IMPORT_PATH:+${QML2_IMPORT_PATH}:}${FALLBACK_QML_PATH}"
fi

ACTION=""
while [ $# -gt 0 ]; do
    case "$1" in
        --action)
            if [ $# -lt 2 ] || [ -z "$2" ]; then
                printf 'Missing action after --action\n' >&2
                exit 2
            fi
            ACTION="${2:-}"
            shift 2
            ;;
        --check-ready)
            ACTION="check-ready"
            shift 1
            ;;
        --stop)
            ACTION="stop"
            shift 1
            ;;
        -h|--help)
            echo "Usage: nyxuri-shell [--action <launcher|session|settings|clipboard|lock|wallpaper-random>|--check-ready|--stop]"
            exit 0
            ;;
        *)
            break
            ;;
    esac
done

if [ -n "$ACTION" ]; then
    case "$ACTION" in
        launcher)
            exec qs -p "${SHELL_DIR}" ipc call spotlight toggle
            ;;
        session)
            exec qs -p "${SHELL_DIR}" ipc call power-menu toggle
            ;;
        settings)
            exec qs -p "${SHELL_DIR}" ipc call control-center toggle ""
            ;;
        clipboard)
            exec qs -p "${SHELL_DIR}" ipc call spotlight openMode clipboard
            ;;
        lock)
            exec qs -p "${SHELL_DIR}" ipc call lock open
            ;;
        wallpaper-random)
            exec qs -p "${SHELL_DIR}" ipc call wallpaper random
            ;;
        check-ready)
            if qs -p "${SHELL_DIR}" ipc show >/dev/null 2>&1; then
                exit 0
            else
                exit 1
            fi
            ;;
        stop)
            exec qs kill -p "${SHELL_DIR}" >/dev/null 2>&1 || true
            ;;
        *)
            echo "Unknown action: ${ACTION}" >&2
            exit 1
            ;;
    esac
fi

# Default: start Nyxuri Shell via quickshell
exec qs -p "${SHELL_DIR}" --no-duplicate "$@"
