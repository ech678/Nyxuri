# shellcheck shell=bash disable=SC2034,SC2154
# Generated by scripts/release.py; dependencies come from packaging/dependencies.json.
pkgbase=nyxuri-shell
pkgname=('nyxuri-shell')
pkgver=@PKGVER@
pkgrel=@PKGREL@
pkgdesc='Nyxuri desktop shell built with Quickshell and Qt Quick'
arch=('any')
url='https://github.com/ech678/Nyxuri'
license=('GPL-3.0-or-later' 'MIT' 'Apache-2.0' 'MPL-2.0' 'LGPL-3.0-only' 'OFL-1.1')
makedepends=@MAKEDEPENDS@
checkdepends=@CHECKDEPENDS@
source=("nyxuri-shell-${pkgver}.tar.gz::${url}/releases/download/v${pkgver}/nyxuri-shell-${pkgver}.tar.gz")
sha256sums=('@SHA256@')

package_nyxuri-shell() {
    depends=@NYXURI_SHELL_DEPENDS@
    optdepends=@NYXURI_SHELL_OPTDEPENDS@
    local dest="${pkgdir}/etc/xdg/quickshell/nyxuri"
    mkdir -p "${dest}" "${pkgdir}/usr/share/licenses/nyxuri-shell"
    cp -r "nyxuri-shell-${pkgver}/app" \
          "nyxuri-shell-${pkgver}/modules" \
          "nyxuri-shell-${pkgver}/shared" \
          "nyxuri-shell-${pkgver}/assets" \
          "nyxuri-shell-${pkgver}/scripts" \
          "nyxuri-shell-${pkgver}/shell.qml" \
          "${dest}/"
    install -Dm755 "nyxuri-shell-${pkgver}/nyxuri-shell" "${dest}/bin/nyxuri-shell"
    install -Dm644 "nyxuri-shell-${pkgver}/packaging/systemd/user/nyxuri-shell.service" \
                   "${pkgdir}/usr/lib/systemd/user/nyxuri-shell.service"
    install -Dm644 "nyxuri-shell-${pkgver}/LICENSE" "${pkgdir}/usr/share/licenses/nyxuri-shell/LICENSE"
    cp -r "nyxuri-shell-${pkgver}/assets/licenses" "${pkgdir}/usr/share/licenses/nyxuri-shell/third-party"
}
