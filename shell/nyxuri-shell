#!/usr/bin/env bash
# ==============================================================================
# Nyxuri Shell Launcher & Gateway (nyxuri-shell)
# Native wrapper for starting Nyxuri Shell and dispatching shell actions.
# ==============================================================================

set -euo pipefail

SOURCE_FILE="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || realpath "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "${SOURCE_FILE}")" && pwd)
SHELL_DIR="${SCRIPT_DIR}"

# Named-module shim home: M3Shapes (the pure-QML stand-in for the retired
# external shapes plugin) lives next to the vendored shape math it will
# eventually absorb. The engine looks for <import-path>/<Module>/qmldir here.
SHAPES_QML_PATH="${SHELL_DIR}/ui/shapes"
if [ -d "${SHAPES_QML_PATH}" ]; then
    export QML_IMPORT_PATH="${QML_IMPORT_PATH:+${QML_IMPORT_PATH}:}${SHAPES_QML_PATH}"
    export QML2_IMPORT_PATH="${QML2_IMPORT_PATH:+${QML2_IMPORT_PATH}:}${SHAPES_QML_PATH}"
fi

# The Quickshell QML disk cache lives in a nyxuri-shell-private cache
# namespace: 0.3.2 serves stale compilation units after source edits, and
# multiple quickshell instances share (and stomp) the default cache dir.
# It is cleared on every launch — a cold compile with the unit warm-up
# imports is verified clean, and freshness beats cold-start milliseconds.
# Do NOT set QML_DISABLE_DISK_CACHE instead: without the cache write, every
# Loader load re-hits the 0.3.2 qs-import defect and units die at cold
# compile.
export NYXURI_ORIGINAL_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_CACHE_HOME="${NYXURI_ORIGINAL_CACHE_HOME}/nyxuri-shell"
rm -rf "${XDG_CACHE_HOME}/quickshell/qmlcache"

# The generated palette has to be written where the shell reads it. The two sides
# defaulted to different places: scripts/lib/nyxuri-paths.sh resolves to
# $XDG_STATE_HOME/quickshell/user/generated, while Paths.qml computed
# <dataHome>/profiles/<profile>/generated. Whenever those disagree the palette is
# written somewhere nothing reads, and every theme change looks inert. Pin both
# to the same directory here, which is also the only place the deployer would set.
GENERATED_HOME_DEFAULT="${XDG_STATE_HOME:-$HOME/.local/state}/quickshell/user/generated"
export NYXURI_SHELL_GENERATED_HOME="${NYXURI_SHELL_GENERATED_HOME:-$GENERATED_HOME_DEFAULT}"

ACTION=""
IPC_CALL=""
while [ $# -gt 0 ]; do
    case "$1" in
        --ipc)
            if [ $# -lt 3 ] || [ -z "$2" ] || [ -z "$3" ]; then
                printf 'Usage: nyxuri-shell --ipc <target> <method> [args...]\n' >&2
                exit 2
            fi
            IPC_CALL=1
            shift 1
            ;;
        --action)
            if [ $# -lt 2 ] || [ -z "$2" ]; then
                printf 'Missing action after --action\n' >&2
                exit 2
            fi
            ACTION="${2:-}"
            shift 2
            ;;
        --check-ready)
            ACTION="check-ready"
            shift 1
            ;;
        --stage)
            ACTION="stage"
            shift 1
            ;;
        --status)
            ACTION="status"
            shift 1
            ;;
        --stop)
            ACTION="stop"
            shift 1
            ;;
        -h|--help)
            echo "Usage: nyxuri-shell [--action <launcher|session|settings|clipboard|lock|wallpaper-random|wallpaper-picker|radial-launcher|translate>|--ipc <target> <method> [args...]|--check-ready|--stage|--status|--stop]"
            exit 0
            ;;
        *)
            break
            ;;
    esac
done

if [ -n "$IPC_CALL" ]; then
    # Generic unit-IPC passthrough for compositor bindings: binds reference
    # this PATH-stable gateway instead of a quickshell config name.
    exec qs -p "${SHELL_DIR}" ipc call "$@"
fi

if [ -n "$ACTION" ]; then
    case "$ACTION" in
        launcher)
            exec qs -p "${SHELL_DIR}" ipc call spotlight toggle
            ;;
        session)
            exec qs -p "${SHELL_DIR}" ipc call power-menu toggle
            ;;
        settings)
            exec qs -p "${SHELL_DIR}" ipc call control-center toggle ""
            ;;
        clipboard)
            exec qs -p "${SHELL_DIR}" ipc call spotlight openMode clipboard
            ;;
        lock)
            if ! qs -p "${SHELL_DIR}" ipc call lock open 2>/dev/null; then
                qs -p "${SHELL_DIR}" --no-duplicate >/dev/null 2>&1 &
                for _ in $(seq 1 30); do
                    sleep 0.1
                    if qs -p "${SHELL_DIR}" ipc call lock open 2>/dev/null; then
                        exit 0
                    fi
                done
                exit 1
            fi
            exit 0
            ;;
        wallpaper-random)
            exec qs -p "${SHELL_DIR}" ipc call wallpaper random
            ;;
        wallpaper-picker)
            exec qs -p "${SHELL_DIR}" ipc call control-center toggle "wallpaper"
            ;;
        radial-launcher)
            tools_dir="${HOME}/.config/noctalia/tools"
            if [ -x "$tools_dir/orbit-launcher.py" ]; then
                exec "$tools_dir/orbit-launcher.py"
            fi
            if [ -f "$tools_dir/orbit-launcher.py" ]; then
                exec python3 "$tools_dir/orbit-launcher.py"
            fi
            exit 0
            ;;
        translate)
            tools_dir="${HOME}/.config/noctalia/tools"
            if [ -x "$tools_dir/orbit-translate.py" ]; then
                exec "$tools_dir/orbit-translate.py"
            fi
            if [ -f "$tools_dir/orbit-translate.py" ]; then
                exec python3 "$tools_dir/orbit-translate.py"
            fi
            exit 0
            ;;
        stage)
            exec qs -p "${SHELL_DIR}" ipc call shell stage
            ;;
        status)
            exec qs -p "${SHELL_DIR}" ipc call shell status
            ;;
        check-ready)
            if res=$(qs -p "${SHELL_DIR}" ipc call shell isReady 2>/dev/null); then
                if [ "${res}" = "true" ]; then
                    exit 0
                fi
                exit 1
            fi
            if qs -p "${SHELL_DIR}" ipc show >/dev/null 2>&1; then
                exit 0
            else
                exit 1
            fi
            ;;
        stop)
            exec qs kill -p "${SHELL_DIR}" >/dev/null 2>&1 || true
            ;;
        *)
            echo "Unknown action: ${ACTION}" >&2
            exit 1
            ;;
    esac
fi

# Default: start Nyxuri Shell via quickshell
exec qs -p "${SHELL_DIR}" --no-duplicate "$@"
