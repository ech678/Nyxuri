# Nyxuri Git Ignore Rules

# Agent instructions & development notes
notes/


# Python cache & bytecode
__pycache__/
*.py[cod]

# Temp & backup files
*.tmp
*.bak

# Build artifacts
build/
build-*/
.build/
*.so
*.o
*.a

# Quickshell & local state
.qmlls.ini
.packaging/
local/

# Local, pinned upstream reference (recreate from the commit in llms-wiki/shell/references.md)
/references/
/shell/references/

# devtools chroot 构建产物（build 在 packaging/ 内进行）
packaging/*.log
packaging/*.pkg.tar.zst
packaging/nyxuri-git/
