# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicitly lock LF on core scripts and configs
*.sh text eol=lf
*.bash text eol=lf
*.py text eol=lf
*.kdl text eol=lf
*.fish text eol=lf
*.toml text eol=lf
*.conf text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf

# Exclude static media and third-party assets from GitHub linguist stats
assets/** linguist-vendored
