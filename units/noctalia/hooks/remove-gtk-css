#!/usr/bin/env python3
"""仅撤回 Noctalia 已登记且最后写入身份仍一致的外部产物。"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[3]))
from nyxuri.desktop.owned_outputs import withdraw_outputs


def main() -> int:
    # 普通 CSS 文本和 gtk-dark.css 文件名均不构成归属证明。
    withdraw_outputs(producer="noctalia", ordinary_only=True)
    return 0


if __name__ == "__main__":
    sys.exit(main())
