#!/usr/bin/env python3
"""部署带归属记录的皮肤模板与 Rime 补丁，重试时保护后续个人修改。"""
import os
import shutil
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[3]))  # standalone runs

from nyxuri.desktop.owned_outputs import write_output  # noqa: E402

THEME = "nyxmellow"
SCHEMA = "rime_ice"
OWNED_MARKER = f"fcitx-{THEME}-rime.owned"

RELOAD_CLASSICUI = [
    "busctl", "--user", "--auto-start=no", "call", "org.fcitx.Fcitx5", "/controller",
    "org.fcitx.Fcitx.Controller1", "ReloadAddonConfig", "s", "classicui",
]
RELOAD_CONFIG = [
    "busctl", "--user", "--auto-start=no", "call", "org.fcitx.Fcitx5", "/controller",
    "org.fcitx.Fcitx.Controller1", "ReloadConfig",
]


def _timed(argv, timeout, **kwargs):
    """有界执行运行时重载；缺命令或超时由调用方按可选动作处理。"""
    try:
        return subprocess.run(argv, timeout=timeout, check=False, **kwargs)
    except (OSError, subprocess.TimeoutExpired):
        return None


def deploy_skin(unit_src: Path) -> bool:
    """逐文件部署皮肤模板，记录原值并保护部署后的个人修改。"""
    source = unit_src / "hooks" / "skin" / "templates"
    if not source.is_dir():
        print(f"[!] skin payload missing in unit blueprint: {source}")
        return False
    theme_dir = Path.home() / ".local/share/fcitx5/themes" / THEME
    for item in source.iterdir():
        if item.is_file() and not write_output("fcitx5-rime", "fcitx5-rime",
                                              theme_dir / "templates" / item.name, item.read_bytes(),
                                              force=os.environ.get("NYXURI_FORCE") == "1"):
            print(f"[!] skin template has user changes: {item.name}")
            return False
    return True


def mount_rime(rime_dir: Path, marker: Path) -> None:
    """声明可用的 Rime schema，原值与提交身份交给统一产物清单保存。

    marker 参数保留调用兼容；旧文件名清单缺少原值和hash，不能升级成清理凭据。
    user.yaml 的上次方案、开关与构建时间由 Rime 维护，不由部署钩子创建或认领。
    """
    rime_dir.mkdir(parents=True, exist_ok=True)
    custom_yaml = rime_dir / "default.custom.yaml"
    content = custom_yaml.read_text(encoding="utf-8") if custom_yaml.is_file() else ""
    if SCHEMA not in content:
        if "patch:" in content and "schema_list:" in content:
            content = content.replace("schema_list:\n", "schema_list:\n    - schema: rime_ice\n", 1)
        elif "patch:" in content:
            content = content.rstrip() + "\n  schema_list:\n    - schema: rime_ice\n"
        else:
            content = content.rstrip() + ("\n\n" if content.strip() else "") + "patch:\n  schema_list:\n    - schema: rime_ice\n"
        if not write_output("fcitx5-rime", "fcitx5-rime", custom_yaml, content.encode(),
                            force=os.environ.get("NYXURI_FORCE") == "1"):
            raise RuntimeError("Rime patch has user changes")
    # default.custom.yaml 负责可用方案；Rime 会在构建和使用时更新 user.yaml。
    # 若把后者整体登记为模板产物，构建时间变化就会被误当成部署后的个人修改。
    shared = Path("/usr/share/rime-data")
    if shutil.which("rime_deployer") and shared.is_dir():
        _timed(["rime_deployer", "--build", str(rime_dir), str(shared), str(rime_dir / "build")], 45)


def main() -> int:
    home = Path.home()
    unit_src = Path(os.environ.get("NYXURI_UNIT_SRC", Path(__file__).resolve().parents[2]))

    if not deploy_skin(unit_src):
        return 1
    mount_rime(home / ".local/share/fcitx5/rime", home / ".local/state/nyxuri" / OWNED_MARKER)

    # Best-effort activations: noctalia renders the skin with the current
    # palette; fcitx5 picks the theme up live via its D-Bus controller.
    if shutil.which("noctalia"):
        for verb, timeout in (("config-reload", 15), ("templates-apply", 30)):
            _timed(["noctalia", "msg", verb], timeout,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    else:
        print("[!] noctalia CLI not in PATH; skin render pending until next deploy")
    if shutil.which("busctl"):
        _timed(RELOAD_CLASSICUI, 5, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        _timed(RELOAD_CONFIG, 5, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    print("[✓] NyxMellow skin deployed, rime_ice mounted")
    return 0


if __name__ == "__main__":
    sys.exit(main())
