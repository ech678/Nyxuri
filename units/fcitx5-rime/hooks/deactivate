#!/usr/bin/env python3
"""撤回有完整归属记录的 Fcitx 产物，保留来源不明和用户后来修改的内容。"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[3]))
from nyxuri.desktop.owned_outputs import withdraw_outputs


def revert_rime(rime_dir: Path, marker: Path) -> None:
    """按完整原值恢复；旧 marker 不能授权按行删除个人文件。"""
    withdraw_outputs(producer="fcitx5-rime", ordinary_only=True)


def withdraw_skin(theme_dir: Path) -> None:
    """按消费者记录清理皮肤，固定文件名不构成所有权。"""
    withdraw_outputs(consumer="fcitx5-rime", ordinary_only=True)


def main() -> int:
    withdraw_outputs(consumer="fcitx5-rime", ordinary_only=True)
    print("[✓] Tracked Fcitx outputs withdrawn; user changes preserved")
    return 0


if __name__ == "__main__":
    sys.exit(main())
