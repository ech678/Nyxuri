#!/usr/bin/env python3
"""恢复原显示管理器并撤回 Greeter 授权，软件包保持安装。

Arch 恢复原配置并清理单元创建的状态目录；Ubuntu 的配置和状态属于软件包，
停用时原样保留。恢复服务失败时不继续清理恢复材料，允许重试。
"""
import shutil
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[3]))  # standalone runs

from nyxuri.core import (  # noqa: E402
    GREETER_DM_STATE,
    GREETER_ETC_CFG,
    GREETER_PKG,
    GREETER_POLKIT_RULE,
    GREETER_STATE_DIR,
)
from nyxuri.core import msg  # noqa: E402
from nyxuri.pkg.platform import current_platform  # noqa: E402

# Ubuntu 的 gdm3 可能只是 gdm 的别名；两种名称均可出现在已有恢复记录中。
CONFLICT_DMS = ["sddm", "lightdm", "gdm3", "gdm", "ly"]


def _backup_path(path: Path) -> Path:
    return Path(f"{path}.nyxuri.bak")


def _recorded_display_manager():
    if not GREETER_DM_STATE.is_file():
        return True, None
    try:
        result = subprocess.run(
            ["sudo", "cat", str(GREETER_DM_STATE)], capture_output=True, text=True, check=False
        )
    except OSError:
        return False, None
    dm = result.stdout.strip()
    allowed = CONFLICT_DMS + (["greetd", "none"] if current_platform() == "ubuntu" else [])
    if result.returncode != 0 or dm not in allowed:
        return False, None
    return True, dm


def _enable_greetd() -> bool:
    try:
        return subprocess.run(
            ["sudo", "systemctl", "enable", "--force", "greetd"], check=False
        ).returncode == 0 and subprocess.run(
            ["systemctl", "is-enabled", "greetd"], capture_output=True, check=False
        ).returncode == 0
    except OSError:
        return False


def _clear_display_manager_record() -> bool:
    try:
        return subprocess.run(["sudo", "rm", "-f", str(GREETER_DM_STATE)], check=False).returncode == 0
    except OSError:
        return False


def main() -> int:
    """先恢复服务，再清理本单元的授权；Ubuntu 保留包内配置与外观数据。"""
    ubuntu = current_platform() == "ubuntu"
    valid_record, previous_dm = _recorded_display_manager()
    if not shutil.which("systemctl"):
        print(msg("greeter_enable_failed"))
        return 1
    try:
        greetd_enabled = subprocess.run(
            ["systemctl", "is-enabled", "greetd"], capture_output=True, check=False
        ).returncode == 0
    except OSError:
        print(msg("greeter_enable_failed"))
        return 1
    if not valid_record or ((greetd_enabled or ubuntu) and not previous_dm):
        print(msg("greeter_dm_record_invalid"))
        return 1
    # Ubuntu 的 rules.d 对普通用户不可遍历，必须先以特权区分规则缺失和读取失败。
    polkit_backup = _backup_path(GREETER_POLKIT_RULE)
    if ubuntu:
        from nyxuri.desktop.greeter import read_root_file
        rule_ok, rule_content = read_root_file(GREETER_POLKIT_RULE)
        backup_ok, backup_content = read_root_file(polkit_backup)
        if not rule_ok or not backup_ok:
            print(msg("greeter_cmd_failed", str(GREETER_POLKIT_RULE)))
            return 1
        has_rule, has_backup = rule_content is not None, backup_content is not None
    else:
        has_rule, has_backup = GREETER_POLKIT_RULE.is_file(), polkit_backup.is_file()
    # Ubuntu 的接管前状态可以是 greetd 或无显示管理器，不能把标记当服务名执行。
    keep_greetd = ubuntu and previous_dm == "greetd"
    if ubuntu and previous_dm == "none":
        previous_dm = None
    if keep_greetd:
        disabled = greetd_disabled = True
        previous_dm = None
        if not _enable_greetd():
            print(msg("greeter_greetd_restore_failed"))
            return 1
    elif previous_dm or greetd_enabled:
        try:
            disabled = subprocess.run(["sudo", "systemctl", "disable", "greetd"], check=False).returncode == 0
            greetd_disabled = subprocess.run(
                ["systemctl", "is-enabled", "greetd"], capture_output=True, check=False
            ).returncode != 0
        except OSError:
            disabled = greetd_disabled = False
    else:
        disabled = greetd_disabled = True
    if not disabled or not greetd_disabled:
        print(msg("greeter_enable_failed"))
        if not _enable_greetd():
            print(msg("greeter_greetd_restore_failed"))
        return 1
    if previous_dm:
        try:
            restored = subprocess.run(
                ["sudo", "systemctl", "enable", "--force", previous_dm], check=False
            ).returncode == 0 and subprocess.run(
                ["systemctl", "is-enabled", previous_dm], capture_output=True, check=False
            ).returncode == 0
        except OSError:
            restored = False
        if not restored:
            print(msg("greeter_dm_restore_failed", previous_dm))
            if not _enable_greetd():
                print(msg("greeter_greetd_restore_failed"))
            return 1
        print(msg("greeter_dm_restored", previous_dm))

    bak = _backup_path(GREETER_ETC_CFG)
    if not ubuntu and bak.is_file():
        if subprocess.run(["sudo", "mv", "-f", str(bak), str(GREETER_ETC_CFG)], check=False).returncode != 0:
            print(msg("greeter_cmd_failed", str(GREETER_ETC_CFG)))
            return 1
        print(msg("greeter_uninstall_restored", str(GREETER_ETC_CFG)))
    elif not ubuntu:
        print(msg("greeter_uninstall_nobackup"))

    if has_backup:
        if subprocess.run(["sudo", "mv", "-f", str(polkit_backup), str(GREETER_POLKIT_RULE)], check=False).returncode != 0:
            print(msg("greeter_cmd_failed", str(GREETER_POLKIT_RULE)))
            return 1
        print(msg("greeter_uninstall_polkit_restored"))
    elif has_rule:
        if subprocess.run(["sudo", "rm", "-f", str(GREETER_POLKIT_RULE)], check=False).returncode != 0:
            print(msg("greeter_cmd_failed", str(GREETER_POLKIT_RULE)))
            return 1
        print(msg("greeter_uninstall_polkit"))

    if not ubuntu:
        if subprocess.run(["sudo", "rm", "-rf", str(GREETER_STATE_DIR)], check=False).returncode != 0:
            print(msg("greeter_cmd_failed", str(GREETER_STATE_DIR)))
            return 1
        print(msg("greeter_uninstall_state_dir", str(GREETER_STATE_DIR)))
    if not _clear_display_manager_record():
        print(msg("greeter_cmd_failed", str(GREETER_DM_STATE)))
        return 1

    print(msg("greeter_uninstall_done"))
    return 0


if __name__ == "__main__":
    sys.exit(main())
