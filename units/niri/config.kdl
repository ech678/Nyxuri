// 引入由 nwg-displays 生成的显示器配置
include "monitor.kdl"
// 动态引入视觉特效样式 (普通模式 vs 护眼模式)
include "effects.kdl"
// 引入输入设备与手势配置 (受 Dunder Protocol 保护，更新自动保留)
include optional=true "input__custom__.kdl"
// 引入布局设置
include "layout.kdl"
// 引入焦点环与阴影光晕零件 (default / glow / glow-material-you)
include "glow.kdl"
// 引入动画配置
include "animations.kdl"
// 引入窗口与图层规则
include "rules.kdl"
// 引入快捷键绑定配置
include "binds.kdl"

overview {
    backdrop-color "#4c566a90"
    workspace-shadow {
        off
    }
}

environment {
    XDG_CURRENT_DESKTOP "niri"
    XDG_SESSION_TYPE "wayland"
    // Niri 启动的 GTK 应用使用 Fcitx 模块；Ubuntu 26.04 实测可提交 Rime 中文。
    // 这里只设置子进程环境，不改 GNOME 会话或 systemd 的全局输入法选择。
    GTK_IM_MODULE "fcitx"
    QT_QPA_PLATFORM "wayland;xcb"
    QT_QPA_PLATFORMTHEME "gtk3"
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
}

spawn-at-startup "~/.config/niri/scripts/session-shell.sh"
// 登录后直接启动 GTK portal，解除上一会话退出时可能遗留的 D-Bus 激活等待。
// niri --session 已导入显示环境；服务自行等待 graphical-session.target，
// --no-block 只提交启动任务，已运行的服务不会重启，也不阻塞 Shell 启动。
spawn-at-startup "systemctl" "--user" "--no-block" "start" "xdg-desktop-portal-gtk.service"
// niri does not consume /etc/xdg/autostart entries on its own.
spawn-at-startup "sh" "-c" "command -v fcitx5 >/dev/null 2>&1 && exec fcitx5 -d"
spawn-at-startup "~/.config/niri/scripts/toggle-eyecare.sh" "--sync"

hotkey-overlay {
    skip-at-startup
}

prefer-no-csd
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

debug {
    honor-xdg-activation-with-invalid-serial
}

recent-windows {
    binds {
        Alt+Tab         { next-window scope="output"; }
        Alt+Shift+Tab   { previous-window scope="output"; }
        Alt+grave       { next-window filter="app-id"; }
        Alt+Shift+grave { previous-window filter="app-id"; }
    }
    highlight {
        corner-radius 12
        active-color "#b6c7e7"
        urgent-color "#ffb4ab"
    }
}

cursor {
    xcursor-theme "Adwaita"
    xcursor-size 24
}

// ==========================================================
// 用户自定义配置 (User Custom Configuration)
// 将自定义的自启项或窗口规则写在 __custom__.kdl 中，更新时自动保留。
// 你也可以在当前目录创建 __custom__/ 文件夹放置个人脚本。
// ==========================================================
// 动态引入 Noctalia 生成的主题配色 (受 Manifest preserve 保护)
include optional=true "noctalia.kdl"

include "__custom__.kdl"
