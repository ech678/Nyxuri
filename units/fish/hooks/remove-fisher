#!/usr/bin/env python3
"""只撤回有原值和最后写入身份的固定插件；旧文件名清单不授权删除。"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[3]))
from nyxuri.desktop.owned_outputs import withdraw_outputs


def main() -> int:
    """恢复未被个人改动的原值；保留旧fisher.json及来源不明的插件文件。"""
    withdraw_outputs(producer="fish-plugins", ordinary_only=True)
    return 0


if __name__ == "__main__":
    sys.exit(main())
