pkgver() {
    cd "$srcdir/$pkgname"
    # v3.0.2 → 3.0.2 ; or r<count>.<short> when no tag reachable
    git describe --long --tags 2>/dev/null | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' \
        || printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

package() {
    cd "$srcdir/$pkgname"

    # Ship the engine + configs + assets + bootstrap to /usr/share/nyxniri.
    install -d "$pkgdir/usr/share/nyxniri"
    cp -a nyxniri configs assets install.sh "$pkgdir/usr/share/nyxniri/"

    # .system-install marker → run_mode="system" (§5.2). Must exist before the
    # configs/assets dir probe so the package isn't mis-detected as 'repo'.
    touch "$pkgdir/usr/share/nyxniri/.system-install"

    # CLI entry → install.sh (the marker + this link make `nyxniri` work system-wide)
    install -d "$pkgdir/usr/bin"
    ln -s ../share/nyxniri/install.sh "$pkgdir/usr/bin/nyxniri"

    # Strip Python bytecode caches and the git history from the payload.
    find "$pkgdir/usr/share/nyxniri" -type d -name '__pycache__' -prune -exec rm -rf {} +
}
