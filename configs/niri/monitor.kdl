// -----------------------------------------------------------------------------
// NyxNiri 显示器配置文件 (monitor.kdl)
// -----------------------------------------------------------------------------
// 说明：此文件用于存放针对您个人硬件设备的物理显示器配置（如分辨率、刷新率、缩放与位置）。
// 
// 提示：默认情况下无需在此填写任何内容，Niri 会自动识别并以推荐设置驱动所有连接的显示器。
// 如需针对特定屏幕进行个性化调整，请参考以下示例取消注释并修改。
// 官方 Output 配置文档: https://github.com/YaLteR/niri/wiki/Configuration:-Outputs
// -----------------------------------------------------------------------------

// 示例 1: 笔记本内置屏幕 (标准 1080p@60Hz)
// output "eDP-1" {
//     mode "1920x1080@60.000"
//     scale 1.0
//     position x=0 y=0
// }

// 示例 2: 外接高刷主显示器 (2K 165Hz 开启按需 VRR)
// output "DP-1" {
//     mode "2560x1440@165.000"
//     scale 1.0
//     transform "normal"
//     position x=0 y=0
//     // 开启可变刷新率 (VRR / G-Sync / FreeSync)
//     // 强烈推荐添加 on-demand=true：仅在运行游戏等规则应用时激活 VRR。
//     // 这能彻底避免桌面静止、锁屏或终端光标跳变时因刷新率骤降产生的屏幕亮度频闪 (VRR Flicker)。
//     variable-refresh-rate on-demand=true
// }
//
// 示例 3: 外接高刷副显示器 (1080p 144Hz 开启按需 VRR)
// output "HDMI-A-1" {
//     mode "1920x1080@144.000"
//     scale 1.0
//     transform "normal"
//     position x=2560 y=0
//     variable-refresh-rate on-demand=true
// }
