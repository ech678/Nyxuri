## Pacman Orphans ##

_mc_orphans() {
    if [[ $(pacman -Qdtq | head -c1 | wc -c) -ne 0 ]]; then
        if _mc_confirm "Clean out all orphan packages"; then
            printf '\nThe following will be uninstalled:\n'
            printf '%s\n' "$(pacman -Rs --print-format '%n %v %r %sB' - < <(pacman -Qdtq) | column -t)"
            if _mc_confirm "Continue with removal"; then
                local _mc_diff=0 _tmp _pid
                _mc_sudo_wrap -v || return 0
                _tmp=$(mktemp) || return 1
                { pacman -Qdtq | LANG=C _mc_sudo_wrap pacman -Rns --noconfirm - | awk '/Total Removed/ { s = $4$5; sub(/B$/, "", s); print s }' | LC_ALL=C numfmt --from=iec-i >"$_tmp" ; } & _pid="$!"
                _mc_loading "Working.." "$_pid" || { rm -f "$_tmp" ; return 1 ; }
                read -r _mc_diff <"$_tmp" || _mc_diff=0
                rm -f "$_tmp"
                [[ $_mc_diff =~ ^[0-9]+$ ]] || _mc_diff=0
                printf "Done\n"
                _mc_bigdiff+=("$_mc_diff"); _mc_bytcon "$_mc_diff"
            else
                printf "Skipped\n"
            fi
        else
            printf "Skipped\n"
        fi
    fi
}

