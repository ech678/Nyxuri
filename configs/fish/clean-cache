## Genesis and Judgement ##

_mc_scr_path="${BASH_SOURCE[0]}"
_xdg_base_config="${XDG_CONFIG_HOME:-$HOME/.config}"
_mc_config_dir="$_xdg_base_config/maclean"
_mc_config_file="$_mc_config_dir/maclean.conf"
install -d -m0755 "$_mc_config_dir"

_mc_deffcon() {
    install -m0644 /dev/null "$1"
    cat > "$1" <<'EOF'
## maclean conf file ##

## Directories to be considered junk. Additional folders may be added.
## One path on each line. Please Use Caution. Targets will be deleted.

_mc_junk_dirs=(
	~/.adobe
	~/.macromedia
)
EOF
}

_mc_canonize() {
    # Canonicalize with realpath, fallback to readlink
    local _path=$1 _warn="${2:-1}" _out
    if command -v realpath >/dev/null 2>&1; then
        _out="$(realpath -- "$_path" 2>/dev/null)" || { [[ $_warn -eq 1 && ( -e "$_path" || -L "$_path" ) ]] && printf 'Warning: could not obtain real path, skipping: %s\n' "$_path" >&2; return 1; }
    elif command -v readlink >/dev/null 2>&1; then
        _out="$(readlink -f -- "$_path" 2>/dev/null)" || { [[ $_warn -eq 1 && ( -e "$_path" || -L "$_path" ) ]] && printf 'Warning: could not obtain real path, skipping: %s\n' "$_path" >&2; return 1; }
    else
        [[ $_warn -eq 1 && ( -e "$_path" || -L "$_path" ) ]] && printf 'Warning: could not obtain real path, skipping: %s\n' "$_path" >&2; return 1
    fi
    printf '%s' "$_out"
}

_mc_loadcon() {
    local _mc_con_file _mc_arr_in _mc_arr_saw _line
    local -n _mc_junk_arr

    _mc_con_file="$1"
    _mc_junk_arr="$2"

    [[ -n "$_mc_con_file" && -f "$_mc_con_file" && -r "$_mc_con_file" ]] || { printf 'Error: config file missing or not readable: %s\n' "$_mc_con_file" >&2; return 1; }

    # Basic file perm checks ?
    # [[ "$(stat -c '%U' "$_mc_con_file")" != "$USER" ]] && return 1
    # [[ "$(stat -c '%a' "$_mc_con_file")" != "600" ]] && return 1

    _mc_arr_in=0
    _mc_arr_saw=0
    _mc_junk_arr=()

    while IFS= read -r _line || [[ -n "$_line" ]]; do

        # Outer quick-skip blanks or comments
        if [[ $_mc_arr_in -eq 0 ]]; then
            [[ "$_line" =~ ^[[:space:]]*$ || "$_line" =~ ^[[:space:]]*# ]] && continue
        fi

        # Enter array (allow optional ' ' and '=')
        if [[ $_mc_arr_in -eq 0 && "$_line" =~ ^[[:space:]]*_mc_junk_dirs[[:space:]]*=?[[:space:]]*\( ]]; then
            _mc_arr_saw=1
            _mc_arr_in=1
            continue
        fi

        # Exit on a line of closing parenthesis (allow spaces)
        if [[ $_mc_arr_in -eq 1 && "$_line" =~ ^[[:space:]]*\)[[:space:]]*$ ]]; then
            _mc_arr_in=0
            continue
        fi

        # Process array lines
        if [[ $_mc_arr_in -eq 1 ]]; then

            # Trim leading/trailing whitespace
            _line="${_line#"${_line%%[![:space:]]*}"}"
            _line="${_line%"${_line##*[![:space:]]}"}"

            # Skip empty or comment lines inside array
            [[ -z "$_line" || "$_line" =~ ^# ]] && continue

            # Strip surrounding quotes (greedy capture) and optional trailing comma/space
            #[[ "$_line" =~ ^[\'\"]?(.*)[\'\"]?,?[[:space:]]*$ ]] && _line="${BASH_REMATCH[1]}"

            # Strip surrounding quotes (match specific pairs only)
            if [[ "$_line" =~ ^\"(.*)\"[,[:space:]]*$ ]]; then
                _line="${BASH_REMATCH[1]}"
            elif [[ "$_line" =~ ^\'(.*)\'[,[:space:]]*$ ]]; then
                _line="${BASH_REMATCH[1]}"
            fi

            # Trim any remaining leading/trailing whitespace (again - defensive) then trailing comma
            _line="${_line#"${_line%%[![:space:]]*}"}"
            _line="${_line%"${_line##*[![:space:]]}"}"
            _line="${_line%,}"

            # Expand ~ to $HOME (safe patterns)
            [[ "$_line" == "~" ]] && _line="$HOME"
            # shellcheck disable=SC2088
            [[ "$_line" == '~/'* ]] && _line="${_line/#\~/$HOME}"

            # Quick rejects before canonicalize
            [[ "${_line##*/}" == -* ]] && { printf 'Warning: path component begins with -, skipping: %s\n' "$_line" >&2; continue; }

            # Reject obvious parent-dir components (defensive)
            [[ "$_line" == ".." || "$_line" == ../* || "$_line" == */..* ]] && { printf 'Warning: path contains parent-directory (..), skipping: %s\n' "$_line" >&2; continue; }

            # Canonicalize
            local _mc_canpath
            _mc_canpath="$(_mc_canonize "$_line" 1)" || continue

            # Ensure canonical path is in $HOME
            # shellcheck disable=SC2016
            [[ "$_mc_canpath" != "$HOME"/* ]] && { printf 'Warning: Entry is not in $HOME after canonicalization: %s -> %s\n' "$_line" "$_mc_canpath" >&2; continue; }

            _mc_junk_arr+=("$_mc_canpath")
        fi
    done < "$_mc_con_file"

    # Detect unterminated array start (seen start but still _mc_arr_in)
    if [[ $_mc_arr_saw -eq 1 && $_mc_arr_in -eq 1 ]]; then
        printf 'Error: unterminated _mc_junk_dirs array in config: missing closing )\n' >&2
        return 1
    fi

    # Missing array entirely is acceptable
    return 0
}

if [[ ! -f "$_mc_config_file" ]]; then
    _mc_deffcon "$_mc_config_file"
else
    if ! _mc_loadcon "$_mc_config_file" _mc_junk_dirs; then
        printf 'Warning: config file is unclean or failed to parse; backing up and creating default\n' >&2
        mv "$_mc_config_file" "${_mc_config_file}.bad.$(date +%s)" || mv "$_mc_config_file" "${_mc_config_file}.bad"
        _mc_deffcon "$_mc_config_file"
        if ! _mc_loadcon "$_mc_config_file" _mc_junk_dirs; then
            printf 'Warning: default config parsed incorrectly; continuing with empty list\n' >&2
            _mc_junk_dirs=()
        fi
    fi
fi

_mc_check_sudopath() {
    local _mc_canpath _sudo_path="$1"

    [[ -n "$_sudo_path" && -e "$_sudo_path" && ! -L "$_sudo_path" ]] || { printf 'Warning: nonexistent or symlinked sudo command %s - Skipping sudo\n' "$_sudo_path" >&2; return 1; }

    if command -v realpath >/dev/null 2>&1; then
        _mc_canpath="$(realpath -- "$_sudo_path")" || { printf 'Warning: could not verify sudo path %s - Skipping sudo\n' "$_sudo_path" >&2; return 1; }
    elif command -v readlink >/dev/null 2>&1; then
        _mc_canpath="$(readlink -f -- "$_sudo_path")" || { printf 'Warning: could not verify sudo path %s - Skipping sudo\n' "$_sudo_path" >&2; return 1; }
    else
        printf 'Warning: could not verify sudo path %s - Skipping sudo\n' "$_sudo_path" >&2; return 1
    fi

    case "$_mc_canpath" in
        /usr/bin/sudo|/bin/sudo|/usr/local/bin/sudo) ;;
        *) printf 'Warning: sudo path not in allowlist: %s\n' "$_mc_canpath" >&2; return 1 ;;
    esac

    [[ -f "$_mc_canpath" && -x "$_mc_canpath" ]] || { printf 'Warning: non-executable or non-file sudo command %s - Skipping sudo\n' "$_sudo_path" >&2; return 1; }

    # Parentdir check - inspect CANON path components to detect symlinks and bad perms
    local dir statinfo uid _gid mode
    dir="$_mc_canpath"

    while [[ "$dir" != / ]]; do
        dir="$(dirname -- "$dir")"
        [[ -L "$dir" ]] && { printf 'Warning: symlink in path %s - Skipping sudo\n' "$dir" >&2; return 1; }

        statinfo="$(stat -c '%u:%g:%a' -- "$dir" 2>/dev/null)" || { printf 'Warning: failed to stat %s - Skipping sudo\n' "$dir" >&2; return 1; }
        IFS=: read -r uid _gid mode <<< "$statinfo"

        # reject group-writable or world-writable
        (( 8#$mode & 020 )) && { printf 'Warning: group writable sudo path %s - Skipping sudo\n' "$dir" >&2; return 1; }
        (( 8#$mode & 002 )) && { printf 'Warning: others writable sudo path %s - Skipping sudo\n' "$dir" >&2; return 1; }
        # optional ownership checks
        (( uid != 0 )) && { printf 'Warning: sudo path not root-owned %s - Skipping sudo\n' "$dir" >&2; return 1; }
    done

    return 0
}

_mc_presudo_path="$(command -v sudo 2>/dev/null || true)"
if [[ -n "$_mc_presudo_path" ]] && _mc_check_sudopath "$_mc_presudo_path"; then
    _mc_sudo_path="$_mc_presudo_path"
else
    for _sudo_apath in /usr/bin/sudo /bin/sudo /usr/local/bin/sudo; do
        if [[ -x "$_sudo_apath" ]] && _mc_check_sudopath "$_sudo_apath"; then
            _mc_sudo_path="$_sudo_apath"; break
        fi
    done
fi

## Safer Tools ##

_mc_sudo_wrap() {

    if [[ $_mc_dryrun -eq 1 ]]; then
        case "$1" in
            "-k"|"-p"|"-v")
                printf "[Dry-Run] Would prompt for sudo credentials\n" >&2
                return 0 ;;
            "rm"|"docker"|"flatpak"|"journalctl"|"pacman"|"pkcon"|"snap"|"pip"|"npm"|"yarn"|"bun"|"go"|"ccache"|"shelly"|"cargo"|"gem"|"paccache"|"systemctl")
                printf "[Dry-Run] Would execute: %s\n" "$*" >&2
                return 0 ;;
        esac
    fi
    case "$1" in
        "-k"|"-p"|"-v"|"rm"|"docker"|"du"|"find"|"flatpak"|"journalctl"|"pacman"|"pkcon"|"snap"|"cargo"|"gem"|"paccache"|"systemctl") ;;
        *) printf 'Invalid command: %s\n' "$1" >&2 ; return 1 ;;
    esac
    if [[ -n "${_mc_sudo_path:-}" && -x "$_mc_sudo_path" ]]; then
        "$_mc_sudo_path" "$@"
    else
        "$@"
    fi
}

_mc_rm_safer() {
    local _allow_sudo=0 _path _parent _out _err
    local _existing=() _removable=() _skipped=() _failed=()
    local _mc_protec_paths _mc_protec_canon _mc_protect=0 _mc_canpath _mc_pcanon
    local -a _mc_sys_paths=()

    if [[ "${1:-}" == "_mc_elevate" ]]; then
        _allow_sudo=1
        shift
    fi

    _mc_protec_paths=( "/" )
    if command -v systemd-path >/dev/null 2>&1; then
        mapfile -t _mc_sys_paths < <( systemd-path --no-pager | awk '{print $NF}' | tr ':' '\n' | sed 's:/*$::' | sort -u )
    else
        _mc_sys_paths=( "/boot" "/bin" "/etc" "/efi" "/home" "/lib" "/lib64" "/mnt" "/opt" "/proc" "/root" "/run" "/sbin" "/sys" "/tmp" "/usr" "/usr/local" "/usr/share" "/var" "$HOME" "${XDG_CONFIG_HOME:-$HOME/.config}" "${XDG_CACHE_HOME:-$HOME/.cache}" "${XDG_DATA_HOME:-$HOME/.local/share}" "${XDG_STATE_HOME:-$HOME/.local/state}" )
    fi
    _mc_protec_paths+=("${_mc_sys_paths[@]}")

    _mc_protec_canon=()
    for _path in "${_mc_protec_paths[@]}"; do
        if _mc_canpath="$(_mc_canonize "$_path" 0)"; then
            _mc_protec_canon+=("$_mc_canpath")
        else
            _mc_protec_canon+=("$_path")
        fi
    done

    for _path in "$@"; do
        [[ -n "$_path" ]] || continue
        [[ "$_path" != -* ]] || { printf 'Error: option-like path refused: %s\n' "$_path" >&2; continue; }
        [[ -L "$_path" ]] && { printf 'Error: %s is a symlink, refusing to delete\n' "$_path" >&2; continue; }
        [[ -e "$_path" ]] || continue

        if _mc_canpath="$(_mc_canonize "$_path" 0)"; then
            _mc_protect=0
            for _mc_pcanon in "${_mc_protec_canon[@]}"; do
                if [[ "$_mc_canpath" == "$_mc_pcanon" ]]; then
                    printf 'Warning: refusing to delete protected path: %s\n' "$_path" >&2
                    _mc_protect=1
                    break
                fi
            done
            (( _mc_protect )) && continue
        fi

        _existing+=("$_path")
    done

    (( ${#_existing[@]} )) || return 0

    # classify each path: removable now (sudo unneeded), or not but add (sudo allowed), or skipped (need sudo but not allowed)
    for _path in "${_existing[@]}"; do
        _parent="${_path%/*}"
        [[ "$_parent" == "$_path" ]] && { _skipped+=("$_path"); continue; }
        if [[ -d "$_parent" && -w "$_parent" && -x "$_parent" ]]; then
            _removable+=("$_path")
        elif [[ $_allow_sudo -eq 1 ]]; then
            _removable+=("$_path")
        else
            _skipped+=("$_path")
        fi
    done

    # Warn on skip (but dont fail)
    if (( ${#_skipped[@]} )); then
        printf 'Warning: skipped %s path(s) requiring sudo:\n' "${#_skipped[@]}" >&2
        printf '%s\n' "${_skipped[@]}" >&2
    fi

    (( ${#_removable[@]} )) || return 0

    # If sudo called but not available then disable
    if [[ $_allow_sudo -eq 1 ]]; then
        if [[ -z "${_mc_sudo_path:-}" || ! -x "${_mc_sudo_path:-}" ]]; then
            printf 'Warning: sudo requested but unavailable; falling back to plain rm\n' >&2
            _allow_sudo=0
        fi
    fi

    # Attempt removals, capture and surface relevant stderr per-path
    for _path in "${_removable[@]}"; do
        _err=0; _out=''
        _mc_canpath="$(_mc_canonize "$_path" 0)" || { _failed+=("$_path"); continue; }
        _parent="${_mc_canpath%/*}"
        [[ "$_parent" == "$_mc_canpath" ]] && { _failed+=("$_path"); continue; }

        if [[ "$_mc_canpath" == /tmp/* || "$_mc_canpath" == /var/tmp/* ]]; then
        if [[ $_mc_dryrun -eq 1 ]]; then _out=""; _err=0; printf "[Dry-Run] Would remove: %s\\n" "$_mc_canpath" >&2; else
            _out="$(LANG=C rm -rf -- "$_mc_canpath" 2>&1)" || _err="$?"
        fi
        elif [[ -d "$_parent" && -w "$_parent" && -x "$_parent" ]]; then
        if [[ $_mc_dryrun -eq 1 ]]; then _out=""; _err=0; printf "[Dry-Run] Would remove: %s\\n" "$_mc_canpath" >&2; else
            _out="$(LANG=C rm -rf -- "$_mc_canpath" 2>&1)" || _err="$?"
        fi
        elif [[ $_allow_sudo -eq 1 ]]; then
        if [[ $_mc_dryrun -eq 1 ]]; then _out=""; _err=0; printf "[Dry-Run] Would remove: %s\\n" "$_mc_canpath" >&2; else
            _out="$(LANG=C _mc_sudo_wrap rm -rf -- "$_mc_canpath" 2>&1)" || _err="$?"
        fi
        else
            printf 'Error: refusing unclassified path: %s\n' "$_mc_canpath" >&2
            _err=1
        fi

        if [[ $_err -ne 0 ]]; then
            # show any stderr lines that are not ENOENT / "No such file or directory" / "not found"
            printf '%s\n' "$_out" | grep -v -E -- 'No such file or directory|not found' | head -n 200 >&2
            _failed+=("$_path")
        fi
    done

    # Warn on failures but dont return non-zero (satisfies 'set -e')
    if (( ${#_failed[@]} )); then
        printf 'Warning: failed to remove %s path(s):\n' "${#_failed[@]}" >&2
        printf '%s\n' "${_failed[@]}" >&2
    fi

    return 0
}

_mc_confirm() {
    local _msg="${1:-Continue?}"
    local _reply
    [[ ${_mc_auto:-0} -eq 1 ]] && return 0
    [[ -r /dev/tty ]] || return 1
    printf '\n%s (y/N)? ' "$_msg" >/dev/tty
    IFS= read -r _reply </dev/tty || return 1
    [[ "$_reply" == [yY]* ]] || return 1
}

_mc_loadani() {
    local _msg=${1:-Working..}
    shift

    local _spin='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
    local _i=0 _pid _alive

    [[ -t 1 ]] || return 0

    while :; do
        _alive=0
        for _pid in "$@"; do
            if kill -0 "$_pid" 2>/dev/null; then
                _alive=1
                break
            fi
        done
        (( _alive )) || break

        printf '\r\033[K%s %s' "${_spin:_i:1}" "$_msg"
        _i=$(( (_i + 1) % ${#_spin} ))
        sleep 0.2
    done
    printf '\r\033[K'

}

_mc_loading() {
    local _msg=$1
    shift
    local _pids=("$@") _pid _spin_pid _rc=0

    (( ${#_pids[@]} )) || return 0

    _mc_loadani "$_msg" "${_pids[@]}" &
    _spin_pid="$!"

    for _pid in "${_pids[@]}"; do
        wait "$_pid" || _rc="$?"
    done

    kill "$_spin_pid" 2>/dev/null
    wait "$_spin_pid" 2>/dev/null

    printf '\r\033[K'
    return "$_rc"
}

## Accounting Functions ##

_mc_bytcon() {
    local _bytes
    _bytes="$(numfmt --to=iec-i --suffix=B --format '%.2f' --round=nearest "${1:-0}" 2>/dev/null)" || _bytes=0
    printf 'Recovered %s\033[0m\n' "$_bytes"
}

_mc_calcsiz() {
    # nameref
    local -n _result_var="$1"
    shift
    local _mc_fcs _out
    _result_var=0
    for _mc_fcs in "$@"; do
        if [[ -e "$_mc_fcs" ]]; then
            if _out="$(du -scb -- "$_mc_fcs" 2>/dev/null | awk 'END{print ($1+0)}')"; then
                :
            elif _out="$(_mc_sudo_wrap du -scb -- "$_mc_fcs" 2>/dev/null | awk 'END{print ($1+0)}')"; then
                :
            else
                _out=0
            fi
            _result_var=$((_result_var + _out))
        fi
    done
}

_mc_calcdif() {
    [[ ${_mc_quicksums:-0} =~ ^[0-9]+$ ]] || _mc_quicksums=0
    [[ ${_mc_quicksums2:-0} =~ ^[0-9]+$ ]] || _mc_quicksums2=0
    _mc_diff=$((_mc_quicksums - _mc_quicksums2))
    (( _mc_diff < 0 )) && _mc_diff=0
    _mc_bigdiff+=("$_mc_diff")
    _mc_bytcon "$_mc_diff"
}

_mc_calcttl() {
    local _mc_numz _mc_tot=0
    if (( ${#_mc_bigdiff[@]} )); then
        for _mc_numz in "${_mc_bigdiff[@]}"; do
            _mc_tot=$((_mc_tot + _mc_numz))
        done
        local _out
        _out="$(_mc_bytcon "$_mc_tot" | sed 's/Recovered/&:/g; s/\x1b\[0m$//')"
        printf '\033[0;32m\nTotal %s\033[0m\n' "$_out"
    else
        printf '\nNo changes applied or none available.\n'
    fi
}

## Junk Function ##

_mc_junker() {

    # NyxNiri Junker Additions
    if _mc_confirm "$(t '释放内存缓存 (Drop Caches)' 'Release memory caches')"; then
        if [[ $_mc_dryrun -eq 1 ]]; then
            printf '[Dry-Run] Would drop caches\n'
        else
            sync && echo 3 | _mc_sudo_wrap tee /proc/sys/vm/drop_caches >/dev/null 2>&1 || true
        fi
        printf "Done\n"
    fi
    if _mc_confirm "$(t '扫描系统配置冲突 (.pacnew / .pacsave)' 'Scan for .pacnew / .pacsave config conflicts')"; then
        local pacnew_files
        pacnew_files=$(find /etc -type f \( -name "*.pacnew" -o -name "*.pacsave" \) 2>/dev/null || true)
        if [[ -n "$pacnew_files" ]]; then
            printf "%s\n" "$(t '发现系统配置文件冲突，建议手动合并：' 'Found config file conflicts, consider merging manually:')"
            echo "$pacnew_files" | while read -r pfile; do echo "  - $pfile"; done
        else
            printf "%s\n" "$(t '未发现配置冲突' 'No config conflicts found')"
        fi
        printf "Done\n"
    fi
    local _mc_fcs _mc_loc=0
    local _mc_existing=()

    for _mc_fcs in "${_mc_junk_dirs[@]}"; do
        [[ -e "$_mc_fcs" ]] && _mc_existing+=("$_mc_fcs")
    done

