## $HOME/Thumbnail Cache ##

_mc_homecache() {
    local _mc_noatime _mc_cachchk _thumbtargets=() _targets=() _mc_findtime
    _mc_cachchk=accessed
    _mc_findtime=-atime
    _mc_noatime=0
    if findmnt -no TARGET /home >/dev/null 2>&1; then
        findmnt -no OPTIONS /home | grep -qw -- noatime && _mc_noatime=1
    else
        findmnt -no OPTIONS / | grep -qw -- noatime && _mc_noatime=1
    fi
    if [[ $_mc_noatime -eq 1 ]]; then
        _mc_cachchk=modified
        _mc_findtime=-mtime
    fi
    mapfile -d '' -t _thumbtargets < <(find "$HOME/.cache/thumbnails" -mindepth 1 -type d \( ! -readable -o ! -executable \) -prune -o -type f "$_mc_findtime" +14 -print0)
    if (( ${#_thumbtargets[@]} )); then
        if _mc_confirm "Clean thumbnail cache of files not $_mc_cachchk for 2 weeks"; then
            local _mc_quicksums=0 _mc_quicksums2=0 _mc_diff=0 _pid
            _mc_calcsiz _mc_quicksums "$HOME/.cache/thumbnails"
            # Do chunks of 64 and 4 async workers
            { local _batch=() _pids=() _rc=0
            for _f in "${_thumbtargets[@]}"; do
                _batch+=("$_f")
                if ((${#_batch[@]} == 64)); then
                    _mc_rm_safer "${_batch[@]}" & _pids+=("$!")
                    _batch=()
                    while ((${#_pids[@]} >= 4)); do
                        wait "${_pids[0]}" || _rc="$?"
