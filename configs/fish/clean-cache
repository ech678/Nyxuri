## Begin Script ##

declare _mc_last_output="" _mc_sudo_path="" _mc_bigdiff=() _mc_junk_dirs=()

trap '{ [[ -e /proc/$$/fd/3 ]] && exec 3<&-; }; { [[ -e /proc/$$/fd/4 ]] && exec 4<&-; }; printf "\nAborted.\n\n" >&2; exit 130' ABRT HUP INT QUIT TERM

