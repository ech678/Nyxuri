#!/usr/bin/env python3
"""noctalia on-hook: ask the daemon to render the GTK Material You templates.

Unit-owned behavior (KM3): the GTK template registration lives in this
unit's noctalia-config.toml; rendering is this unit's declared side
effect. Best-effort — without the noctalia binary the render stays
pending until the next deploy.
"""
import shutil
import subprocess
import sys

BIN = "noctalia"


def main() -> int:
    if not shutil.which(BIN):
        print("[!] noctalia CLI not in PATH; GTK render pending until next deploy")
        return 0
    for argv, timeout in (
        ([BIN, "msg", "config-reload"], 15),
        ([BIN, "msg", "templates-apply"], 30),
    ):
        try:
            subprocess.run(argv, timeout=timeout, check=False,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except (OSError, subprocess.TimeoutExpired):
            print("[!] noctalia render trigger failed; will retry on next deploy")
            return 0
    print("[✓] GTK Material You templates rendered")
    return 0


if __name__ == "__main__":
    sys.exit(main())
